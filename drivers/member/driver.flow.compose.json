    {
      "id": "class_cancelled",
      "title": {
        "en": "A booked class was cancelled",
        "sv": "Ett bokat pass ställdes in"
      },
      "hint": {
        "en": "Fires when an upcoming booked class is cancelled or disappears from your bookings, whether you or SATS cancelled it. Detected at the next refresh.",
        "sv": "Körs när ett kommande bokat pass ställs in eller försvinner från dina bokningar, oavsett om du eller SATS avbokade. Upptäcks vid nästa uppdatering."
      },
      "tokens": [
