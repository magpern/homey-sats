          "title": {
            "en": "Centre",
            "sv": "Center"
          },
          "example": {
            "en": "Example Centre",
            "sv": "Exempelcentret"
          }
        },
        {
          "type": "string",
          "name": "city",
          "title": {
            "en": "City",
            "sv": "Stad"
          },
          "example": {
            "en": "Stockholm",
            "sv": "Stockholm"
          }
        },
        {
          "type": "string",
          "name": "country",
          "title": {
            "en": "Country",
            "sv": "Land"
          },
          "example": {
            "en": "Sweden",
            "sv": "Sverige"
          }
        },
        {
          "type": "number",
          "name": "distance_km",
          "title": {
            "en": "Distance from home (km, -1 if unknown)",
            "sv": "Avstånd hemifrån (km, -1 om okänt)"
          },
          "example": 3.2
        },
        {
          "type": "string",
          "name": "previous_status",
          "title": {
            "en": "Status before (booked / waiting list)",
            "sv": "Status innan (bokat / väntelista)"
          },
          "example": {
            "en": "booked",
            "sv": "booked"
          }
        },
        {
          "type": "string",
          "name": "cancelled_by",
          "title": {
            "en": "Cancelled by (SATS / unknown)",
            "sv": "Inställt av (SATS / okänt)"
          },
          "example": {
            "en": "SATS",
            "sv": "SATS"
          }
        }
      ]
    },
    {
      "id": "waitlist_promoted",
      "title": {
        "en": "Moved from the waiting list to booked",
        "sv": "Flyttad från väntelistan till bokad"
      },
      "hint": {
        "en": "Fires when a class you were on the waiting list for becomes booked. Detected at the next refresh.",
        "sv": "Körs när ett pass du stod på väntelista för blir bokat. Upptäcks vid nästa uppdatering."
      },
      "tokens": [
        {
          "type": "string",
          "name": "class_name",
          "title": {
            "en": "Class name",
            "sv": "Passnamn"
          },
          "example": {
            "en": "Strength 45",
            "sv": "Strength 45"
          }
        },
        {
          "type": "string",
          "name": "start",
          "title": {
            "en": "Start time",
            "sv": "Starttid"
          },
          "example": {
            "en": "06:30",
            "sv": "06:30"
          }
        },
        {
          "type": "string",
          "name": "centre",
          "title": {
            "en": "Centre",
            "sv": "Center"
          },
          "example": {
            "en": "Example Centre",
            "sv": "Exempelcentret"
          }
        },
        {
          "type": "number",
          "name": "previous_position",
          "title": {
            "en": "Previous position (-1 if unknown)",
            "sv": "Tidigare köplats (-1 om okänd)"
          },
          "example": 2
        }
      ]
    },
    {
      "id": "waitlist_position_changed",
      "title": {
        "en": "Waiting list position changed",
        "sv": "Köplatsen ändrades"
      },
      "hint": {
        "en": "Fires when your position on a class's waiting list changes. Needs SATS to report the position.",
        "sv": "Körs när din plats i ett pass väntelista ändras. Kräver att SATS anger köplatsen."
      },
      "tokens": [
        {
          "type": "string",
          "name": "class_name",
          "title": {
            "en": "Class name",
            "sv": "Passnamn"
          },
          "example": {
            "en": "Strength 45",
            "sv": "Strength 45"
          }
        },
        {
          "type": "string",
          "name": "start",
          "title": {
            "en": "Start time",
            "sv": "Starttid"
          },
          "example": {
            "en": "06:30",
            "sv": "06:30"
          }
        },
        {
          "type": "string",
          "name": "centre",
          "title": {
            "en": "Centre",
            "sv": "Center"
          },
          "example": {
            "en": "Example Centre",
            "sv": "Exempelcentret"
          }
        },
        {
          "type": "number",
          "name": "old_position",
          "title": {
            "en": "Old position",
            "sv": "Tidigare köplats"
          },
          "example": 5
        },
        {
          "type": "number",
          "name": "new_position",
          "title": {
            "en": "New position",
            "sv": "Ny köplats"
          },
          "example": 3
        }
      ]
    }
  ],
  "conditions": [
    {
      "id": "class_within_km",
      "title": {
        "en": "Class !{{is|is not}} within … km of home",
        "sv": "Passet !{{är|är inte}} inom … km hemifrån"
      },
      "titleFormatted": {
        "en": "Class !{{is|is not}} within [[km]] km of home",
        "sv": "Passet !{{är|är inte}} inom [[km]] km hemifrån"
      },
      "hint": {
        "en": "Checks the class that triggered this Flow (or else the member's next class) against Homey's location. False if the centre's location is unknown.",
        "sv": "Kontrollerar passet som startade detta flöde (annars medlemmens nästa pass) mot Homeys plats. Falskt om centrets plats är okänd."
      },
      "args": [
        {
          "type": "number",
          "name": "km",
          "title": {
            "en": "Kilometres",
            "sv": "Kilometer"
          },
          "placeholder": {
            "en": "10",
            "sv": "10"
          },
          "min": 0,
          "max": 20000,
          "step": 0.1
        }
      ]
    },
    {
      "id": "class_at_home_centre",
      "title": {
        "en": "Class !{{is|is not}} at one of my home centres",
        "sv": "Passet !{{är|är inte}} på ett av mina hemmacenter"
      },
      "hint": {
        "en": "Checks the class that triggered this Flow (or else the member's next class) against the Home centres in the device settings.",
        "sv": "Kontrollerar passet som startade detta flöde (annars medlemmens nästa pass) mot Hemmacenter i enhetens inställningar."
      }
    }
  ]
}
