{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.github.homeysats",
  "version": "1.0.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "SATS (unofficial)",
    "sv": "SATS (inofficiell)"
  },
  "description": {
    "en": "Let your home react to your booked SATS classes. Unofficial, not affiliated with SATS.",
    "sv": "Låt hemmet reagera på dina bokade SATS-pass. Inofficiell, inte kopplad till SATS."
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "homey-sats contributors"
  },
  "support": "https://github.com/magpern/homey-sats/issues",
  "brandColor": "#0B1F4B",
  "source": "https://github.com/magpern/homey-sats",
  "flow": {
    "conditions": [
      {
        "title": {
          "en": "Any member !{{has|doesn't have}} a booked class before … today/tomorrow",
          "sv": "Någon medlem !{{har|har inte}} ett bokat pass före … idag/imorgon"
        },
        "titleFormatted": {
          "en": "Any member !{{has|doesn't have}} a booked class before [[time]] [[day]]",
          "sv": "Någon medlem !{{har|har inte}} ett bokat pass före [[time]] [[day]]"
        },
        "args": [
          {
            "type": "time",
            "name": "time",
            "title": {
              "en": "Time",
              "sv": "Tid"
            }
          },
          {
            "type": "dropdown",
            "name": "day",
            "title": {
              "en": "Day",
              "sv": "Dag"
            },
            "values": [
              {
                "id": "today",
                "label": {
                  "en": "today",
                  "sv": "idag"
                }
              },
              {
                "id": "tomorrow",
                "label": {
                  "en": "tomorrow",
                  "sv": "imorgon"
                }
              }
            ]
          }
        ],
        "id": "any_member_class_before"
      },
      {
        "id": "class_within_km",
        "title": {
          "en": "Class !{{is|is not}} within … km of home",
          "sv": "Passet !{{är|är inte}} inom … km hemifrån"
        },
        "titleFormatted": {
          "en": "Class !{{is|is not}} within [[km]] km of home",
          "sv": "Passet !{{är|är inte}} inom [[km]] km hemifrån"
        },
        "hint": {
          "en": "Checks the class that triggered this Flow (or else the member's next class) against Homey's location. False if the centre's location is unknown.",
          "sv": "Kontrollerar passet som startade detta flöde (annars medlemmens nästa pass) mot Homeys plats. Falskt om centrets plats är okänd."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=member"
          },
          {
            "type": "number",
            "name": "km",
            "title": {
              "en": "Kilometres",
              "sv": "Kilometer"
            },
            "placeholder": {
              "en": "10",
              "sv": "10"
            },
            "min": 0,
            "max": 20000,
            "step": 0.1
          }
        ]
      },
      {
        "id": "class_at_home_centre",
        "title": {
          "en": "Class !{{is|is not}} at one of my home centres",
          "sv": "Passet !{{är|är inte}} på ett av mina hemmacenter"
        },
        "hint": {
          "en": "Checks the class that triggered this Flow (or else the member's next class) against the Home centres in the device settings.",
          "sv": "Kontrollerar passet som startade detta flöde (annars medlemmens nästa pass) mot Hemmacenter i enhetens inställningar."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=member"
          }
        ]
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Refresh bookings now",
          "sv": "Uppdatera bokningar nu"
        },
        "hint": {
          "en": "Fetches the booked SATS classes of all members right away instead of waiting for the next scheduled poll.",
          "sv": "Hämtar alla medlemmars bokade SATS-pass direkt i stället för att vänta på nästa schemalagda hämtning."
        },
        "id": "refresh_bookings"
      }
    ],
    "triggers": [
      {
        "id": "class_starts_in",
        "title": {
          "en": "A booked class starts in … minutes",
          "sv": "Ett bokat pass börjar om … minuter"
        },
        "titleFormatted": {
          "en": "A booked class starts in [[minutes]] minutes",
          "sv": "Ett bokat pass börjar om [[minutes]] minuter"
        },
        "hint": {
          "en": "Fires once per booked class, the given number of minutes before it starts. Waiting-list places do not count.",
          "sv": "Körs en gång per bokat pass, angivet antal minuter innan det börjar. Platser på väntelistan räknas inte."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=member"
          },
          {
            "type": "number",
            "name": "minutes",
            "title": {
              "en": "Minutes",
              "sv": "Minuter"
            },
            "placeholder": {
              "en": "60",
              "sv": "60"
            },
            "min": 0,
            "max": 1440,
            "step": 1
          }
        ],
        "tokens": [
          {
            "type": "string",
            "name": "class_name",
            "title": {
              "en": "Class name",
              "sv": "Passnamn"
            },
            "example": {
              "en": "Strength 45",
              "sv": "Strength 45"
            }
          },
          {
            "type": "string",
            "name": "start",
            "title": {
              "en": "Start time",
              "sv": "Starttid"
            },
            "example": {
              "en": "06:30",
              "sv": "06:30"
            }
          },
          {
            "type": "string",
            "name": "end",
            "title": {
              "en": "End time",
              "sv": "Sluttid"
            },
            "example": {
              "en": "07:15",
              "sv": "07:15"
            }
          },
          {
            "type": "string",
            "name": "centre",
            "title": {
              "en": "Centre",
              "sv": "Center"
            },
            "example": {
              "en": "Example Centre",
              "sv": "Exempelcentret"
            }
          },
          {
            "type": "string",
            "name": "city",
            "title": {
              "en": "City",
              "sv": "Stad"
            },
            "example": {
              "en": "Stockholm",
              "sv": "Stockholm"
            }
          },
          {
            "type": "string",
            "name": "country",
            "title": {
              "en": "Country",
              "sv": "Land"
            },
            "example": {
              "en": "Sweden",
              "sv": "Sverige"
            }
          },
          {
            "type": "number",
            "name": "distance_km",
            "title": {
              "en": "Distance from home (km, -1 if unknown)",
              "sv": "Avstånd hemifrån (km, -1 om okänt)"
            },
            "example": 3.2
          }
        ]
      },
