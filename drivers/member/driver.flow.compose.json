  ],
  "conditions": [
    {
      "id": "class_within_km",
      "title": {
        "en": "Class !{{is|is not}} within … km of home",
        "sv": "Passet !{{är|är inte}} inom … km hemifrån"
      },
      "titleFormatted": {
        "en": "Class !{{is|is not}} within [[km]] km of home",
        "sv": "Passet !{{är|är inte}} inom [[km]] km hemifrån"
      },
      "hint": {
        "en": "Checks the class that triggered this Flow (or else the member's next class) against Homey's location. False if the centre's location is unknown.",
        "sv": "Kontrollerar passet som startade detta flöde (annars medlemmens nästa pass) mot Homeys plats. Falskt om centrets plats är okänd."
      },
      "args": [
        {
          "type": "number",
          "name": "km",
          "title": {
            "en": "Kilometres",
            "sv": "Kilometer"
          },
          "placeholder": {
            "en": "10",
            "sv": "10"
          },
          "min": 0,
          "max": 20000,
          "step": 0.1
        }
      ]
    },
    {
      "id": "class_at_home_centre",
      "title": {
        "en": "Class !{{is|is not}} at one of my home centres",
        "sv": "Passet !{{är|är inte}} på ett av mina hemmacenter"
      },
      "hint": {
        "en": "Checks the class that triggered this Flow (or else the member's next class) against the Home centres in the device settings.",
        "sv": "Kontrollerar passet som startade detta flöde (annars medlemmens nästa pass) mot Hemmacenter i enhetens inställningar."
      }
    }
  ]
}
