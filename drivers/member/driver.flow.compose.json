    {
      "id": "class_cancelled",
      "title": {
        "en": "A class was cancelled",
        "sv": "Ett pass ställdes in"
      },
      "hint": {
        "en": "Fires when an upcoming class, booked or on the waiting list, is cancelled by SATS (marked cancelled) or disappears from your bookings (cancelled_by is then \"unknown\": you may have unbooked it yourself). Detected at the next refresh.",
        "sv": "Körs när ett kommande pass, bokat eller på väntelista, ställs in av SATS (markerat inställt) eller försvinner från dina bokningar (cancelled_by blir då \"unknown\": du kan ha avbokat själv). Upptäcks vid nästa uppdatering."
      },
      "tokens": [
        {
          "type": "string",
          "name": "class_name",
          "title": {
            "en": "Class name",
            "sv": "Passnamn"
          },
          "example": {
            "en": "Strength 45",
            "sv": "Strength 45"
          }
        },
        {
          "type": "string",
          "name": "start",
          "title": {
            "en": "Start time",
            "sv": "Starttid"
          },
          "example": {
            "en": "06:30",
            "sv": "06:30"
          }
        },
        {
          "type": "string",
          "name": "end",
          "title": {
            "en": "End time",
            "sv": "Sluttid"
          },
          "example": {
            "en": "07:15",
            "sv": "07:15"
          }
        },
        {
          "type": "string",
